      "figure_html": "<!--smartart-src:eyJzbHVnIjogInB5cmFtaWQxIiwgIm91dGxpbmUiOiAi67aI7ZWE7JqU7ZWcIOu2gOu2hCDsoJzsmbggLSDsiJjsgqwg7Iuc6rCEIOygiOyVvVxu7LK066WY7Iuc6rCEIOu2hOyEnSDrk7Eg6re866Gc7Iuc6rCEIOy2lOyglVxu7Yq57KCVIOyduOusvCDrk7Eg7LaU7KCBIiwgInNjaGVtZSI6IG51bGwsICJmb250X3NjYWxlIjogMS4wfQ==-->\n\n<style>\n.smartart-stage { position: relative; width: 100%; height: 100%; }\n.smartart-node {\n  position: absolute; box-sizing: border-box; overflow: hidden;\n  display: flex; align-items: center; justify-content: center;\n  container-type: size;\n  box-shadow: 0 4px 16px rgba(0,0,0,0.18);\n}\n.smartart-node.is-decor { opacity: 0.55; box-shadow: none; }\n/* 상위(data-lvl=0)는 진하고 또렷하게, 하위로 갈수록 살짝 밝고 채도 낮게 + 그림자 약하게 — 위계가 눈에 보이도록 */\n.smartart-node[data-lvl=\"1\"] { filter: brightness(1.12) saturate(0.85); box-shadow: 0 2px 8px rgba(0,0,0,0.14); }\n.smartart-node[data-lvl=\"2\"] { filter: brightness(1.22) saturate(0.72); box-shadow: 0 1px 5px rgba(0,0,0,0.10); }\n.smartart-node[data-lvl=\"1\"] .smartart-label, .smartart-node[data-lvl=\"2\"] .smartart-label { font-weight: 650; }\n.smartart-label {\n  padding: 0.1em 0.3em; text-align: center;\n  font-family: var(--font-kr); font-weight: 800;\n  color: var(--sa-ink, #fff); line-height: 1.15;\n  text-wrap: balance;\n  /* 박스 높이의 ~70~80%에서 시작, 글자수(--len)가 늘수록 폭 기준으로 자동 축소.\n     --sa-scale은 표 글자크기처럼 나중에 편집기에서 다이어그램별로 직접 조정할 배율(기본 1) — 상수로 박아두지 않음. */\n  font-size: clamp(0.72rem, calc(var(--sa-scale, 1) * min(32cqh, calc(170cqw / var(--len, 4)))), 2.8rem);\n}\n.sa-main { }\n.sa-sub { font-size: 0.62em; font-weight: 500; opacity: 0.85; margin-top: 0.25em; }\n</style>\n<div class=\"smartart-stage\" id=\"sa1\" style=\"--sa-ink:var(--ink-white); --sa-scale:1.0;\">\n  <div class=\"smartart-node is-decor\" data-lvl=\"0\" style=\"left:0.00%; top:66.67%; width:100.00%; height:33.33%; border-radius:10px; background:var(--sea-sky);\"></div>\n  <div class=\"smartart-node\" data-lvl=\"0\" style=\"left:17.50%; top:66.67%; width:65.00%; height:33.33%; border-radius:10px; background:linear-gradient(135deg, var(--sea-bright), var(--sea-mid));\"><span class=\"smartart-label\" style=\"--len:21;\"><div class=\"sa-main\">불필요한 부분 제외 - 수사 시간 절약</div></span></div>\n  <div class=\"smartart-node is-decor\" data-lvl=\"0\" style=\"left:9.17%; top:33.33%; width:81.67%; height:33.33%; border-radius:10px; background:var(--sea-sky);\"></div>\n  <div class=\"smartart-node\" data-lvl=\"0\" style=\"left:23.46%; top:33.33%; width:53.08%; height:33.33%; border-radius:10px; background:linear-gradient(135deg, var(--sea-sky), var(--sea-bright));\"><span class=\"smartart-label\" style=\"--len:17;\"><div class=\"sa-main\">체류시간 분석 등 근로시간 추정</div></span></div>\n  <div class=\"smartart-node is-decor\" data-lvl=\"0\" style=\"left:18.33%; top:0.00%; width:63.33%; height:33.33%; border-radius:10px; background:var(--sea-sky);\"></div>\n  <div class=\"smartart-node\" data-lvl=\"0\" style=\"left:29.42%; top:0.00%; width:41.17%; height:33.33%; border-radius:10px; background:linear-gradient(135deg, var(--ink-white), var(--sea-bright));\"><span class=\"smartart-label\" style=\"--len:10;\"><div class=\"sa-main\">특정 인물 등 추적</div></span></div>\n</div>",
